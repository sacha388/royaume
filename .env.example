NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web Push (Safari iOS 16.4+ PWA) — générer les clés : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou URL https (expéditeur VAPID)
VAPID_SUBJECT=mailto:couple@example.com

# Même valeur pour les deux (clé « gate » côté client + serveur). À garder privée dans la pratique.
PUSH_GATE_KEY=
NEXT_PUBLIC_PUSH_GATE_KEY=
